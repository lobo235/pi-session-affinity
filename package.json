{
  "name": "pi-session-affinity",
  "version": "0.0.0",
  "description": "Faster pi on self-hosted and gateway-routed models: keeps each conversation on the inference engine that holds its prompt cache with a per-session routing header, plus an optional post-compaction boundary request.",
  "type": "module",
  "license": "MIT",
  "author": "Justin Barlow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobo235/pi-session-affinity.git"
  },
  "homepage": "https://github.com/lobo235/pi-session-affinity#readme",
  "bugs": {
    "url": "https://github.com/lobo235/pi-session-affinity/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "llm",
    "ai-agents",
    "session-affinity",
    "prefix-cache",
    "prompt-caching",
    "kv-cache",
    "litellm",
    "vllm"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lobo235/pi-session-affinity/v1.0.0/.github/assets/infographic.png"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-support.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && npm run load-smoke && npm run smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "load-smoke": "node load-smoke.mjs",
    "smoke": "node scripts/wire-smoke.ts",
    "check-pack": "node scripts/check-pack.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
